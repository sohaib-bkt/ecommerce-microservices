# API Gateway configuration

# gRPC address of the product service.
PRODUCT_SERVICE_URL=localhost:50052

# Paths are resolved relative to the workspace root (process.cwd()).
# Use absolute paths when launching the compiled app from another directory.
PRODUCT_PROTO_PATH=libs/contracts/proto/product/v1/product.proto
PRODUCT_PROTO_INCLUDE_DIR=libs/contracts/proto

# payment-service
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-service
KAFKA_GROUP_ID=payment-service
STRIPE_GATEWAY=fake
# Required only when STRIPE_GATEWAY=stripe
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_secret

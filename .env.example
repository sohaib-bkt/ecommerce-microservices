# API Gateway configuration

# gRPC address of the product service.
PRODUCT_SERVICE_URL=localhost:50052

# Proto paths may be workspace-relative or absolute. Startup resolves them to
# one absolute path, checks that it exists, and logs the exact path used.
PRODUCT_PROTO_PATH=libs/contracts/proto/product/v1/product.proto
PRODUCT_PROTO_INCLUDE_DIR=libs/contracts/proto

# Account-service gRPC endpoint and contract paths.
ACCOUNT_SERVICE_URL=localhost:50051
ACCOUNT_GRPC_PORT=50051
ACCOUNT_PROTO_PATH=libs/contracts/proto/account/v1/account.proto
ACCOUNT_PROTO_INCLUDE_DIR=libs/contracts/proto

# Order-service gRPC endpoint and contract paths.
ORDER_SERVICE_URL=localhost:50053
ORDER_GRPC_PORT=50053
ORDER_PROTO_PATH=libs/contracts/proto/order/v1/order.proto
ORDER_PROTO_INCLUDE_DIR=libs/contracts/proto

# payment-service
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5433/ecommerce
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-service
KAFKA_ORDER_GROUP_ID=order-service
KAFKA_PAYMENT_GROUP_ID=payment-service
STRIPE_GATEWAY=fake
# Required only when STRIPE_GATEWAY=stripe
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_secret
